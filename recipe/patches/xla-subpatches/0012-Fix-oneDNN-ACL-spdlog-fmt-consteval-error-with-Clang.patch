From 19f8e71ad6c3bbda6eefa281bfa33762b56aa942 Mon Sep 17 00:00:00 2001
From: "Uwe L. Korn" <uwe.korn@quantco.com>
Date: Wed, 1 Jul 2026 18:16:37 +0000
Subject: [PATCH] Fix oneDNN ACL spdlog/fmt consteval error with Clang 20

---
 .../onednn_acl_fix_spdlog_fmt_consteval.patch | 43 +++++++++++++++++++
 third_party/mkl_dnn/workspace.bzl             |  1 +
 2 files changed, 44 insertions(+)
 create mode 100644 third_party/mkl_dnn/onednn_acl_fix_spdlog_fmt_consteval.patch

diff --git a/third_party/mkl_dnn/onednn_acl_fix_spdlog_fmt_consteval.patch b/third_party/mkl_dnn/onednn_acl_fix_spdlog_fmt_consteval.patch
new file mode 100644
index 0000000000..7cba3af8a6
--- /dev/null
+++ b/third_party/mkl_dnn/onednn_acl_fix_spdlog_fmt_consteval.patch
@@ -0,0 +1,43 @@
+# Copyright 2026 The OpenXLA Authors.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+# ==============================================================================
+#
+# The bundled fmt (v11.0.2) implementation of compile-time-checked format
+# strings (FMT_STRING) relies on evaluating a non-constexpr-safe code path
+# inside a consteval constructor. Clang >= 18 rejects this with:
+#   error: call to consteval function ... is not a constant expression
+# because it now propagates immediate-function-context requirements into
+# every sub-expression of a consteval call (matching the C++23 resolution
+# of CWG2334), which fmt 11.0.2 does not yet handle. This affects both
+# spdlog's own call sites and fmt's internal call sites (e.g. bigint
+# formatting), so patch FMT_STRING itself rather than each call site.
+#
+# Since compile-time format-string checking is a diagnostic-only feature
+# (format strings are still checked at runtime), disable it for the
+# bundled fmt used by oneDNN's verbose logging so it builds with newer
+# Clang releases.
+diff --git a/src/common/spdlog/fmt/bundled/format.h b/src/common/spdlog/fmt/bundled/format.h
+index 1111111..2222222 100644
+--- a/src/common/spdlog/fmt/bundled/format.h
++++ b/src/common/spdlog/fmt/bundled/format.h
+@@ -1824,5 +1824,7 @@
+  *     // A compile-time error because 'd' is an invalid specifier for strings.
+  *     std::string s = fmt::format(FMT_STRING("{:d}"), "foo");
+  */
+-#define FMT_STRING(s) FMT_STRING_IMPL(s, fmt::detail::compile_string, )
++// Disabled: fmt 11.0.2's FMT_STRING_IMPL trips a consteval-constant-expression
++// bug with Clang >= 18. Fall back to runtime-checked format strings.
++#define FMT_STRING(s) s
+
+ template <size_t width, typename Char, typename OutputIt>
diff --git a/third_party/mkl_dnn/workspace.bzl b/third_party/mkl_dnn/workspace.bzl
index 14cde92583..ddcd48b733 100644
--- a/third_party/mkl_dnn/workspace.bzl
+++ b/third_party/mkl_dnn/workspace.bzl
@@ -33,6 +33,7 @@ def repo():
         patch_file = [
             "//third_party/mkl_dnn:onednn_acl_lock_fixed_format_matmul.patch",
             "//third_party/mkl_dnn:onednn_acl_threadpool_default_max.patch",
+            "//third_party/mkl_dnn:onednn_acl_fix_spdlog_fmt_consteval.patch",
         ],
         sha256 = "5792cbc07764c6e25c459ff68efb5cfcd7f4a0ba66dca6a4a2c681cd7a644596",
         strip_prefix = "oneDNN-3.7",
