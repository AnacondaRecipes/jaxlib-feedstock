--- a/third_party/protobuf_impl.bzl
+++ b/third_party/protobuf_impl.bzl
@@ -7,7 +7,27 @@
   syslib_label = ctx.attr.systemlib
   syslib_path = ctx.path(syslib_label)
   ctx.execute(["cp", syslib_path, "BUILD"])
   ctx.report_progress("Copied systemlib.BUILD")
+
+  # Native proto_library (and protoc_authenticity's implicit
+  # _proto_compiler attribute, which requires executable = True) both
+  # depend on this target; our systemlib doesn't vendor protobuf's C++
+  # compiler sources, so point it at the real installed protoc instead.
+  ctx.execute(["mkdir", "-p", "src/google/protobuf/compiler"])
+  ctx.file(
+      "src/google/protobuf/compiler/BUILD",
+      "genrule(name = \"protoc_minimal\", outs = [\"protoc_minimal.bin\"], cmd = \"ln -s $(BUILD_PREFIX)/bin/protoc $@\", executable = 1, visibility = [\"//visibility:public\"])\n",
+  )
+
+  # bazel/private/oss/toolchains/prebuilt/BUILD.bazel (another native
+  # proto_library implicit dependency) loads this for its prebuilt-toolchain
+  # registrations, which we don't use; stub it empty so the package loads.
+  ctx.execute(["mkdir", "-p", "toolchain"])
+  ctx.file("toolchain/BUILD", "")
+  ctx.file(
+      "toolchain/platforms.bzl",
+      "PROTOBUF_PLATFORMS = {}\n",
+  )
 
 protobuf_bazel_repo = repository_rule(
     implementation = _protobuf_impl,
